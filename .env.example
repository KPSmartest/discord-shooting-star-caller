# Discord application credentials (Developer Portal → your app)
APPLICATION_ID=your-application-id
DISCORD_PUBLIC_KEY=your-application-public-key
DISCORD_BOT_TOKEN=your-bot-token

# The single server (guild) this private bot serves
GUILD_ID=your-server-id

# IANA timezone used to interpret wall-clock reminder times (e.g. "friday 2pm")
TIMEZONE=Pacific/Auckland

# Where the SQLite database lives. Locally this defaults to ./reminders.db;
# in production it should point at the mounted Fly volume, e.g. /data/reminders.db
DATABASE_PATH=./reminders.db

# HTTP port the interactions server listens on
PORT=3000
